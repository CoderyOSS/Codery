Port 22
Port 2022
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

PermitRootLogin no
AllowUsers gem
AuthenticationMethods publickey
PubkeyAuthentication yes

# /etc/ssh/authorized_keys/%u: baked-in sandbox→apps key (image)
# /run/secrets/authorized_keys: host-managed keys (Blink etc.) — bind-mounted
#   from /opt/codery/ssh/authorized_keys, same file the sandbox uses.
AuthorizedKeysFile /etc/ssh/authorized_keys/%u /run/secrets/authorized_keys

StrictModes no
LogLevel INFO

PasswordAuthentication no
ChallengeResponseAuthentication no
UsePAM no

PrintMotd no
#AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server
