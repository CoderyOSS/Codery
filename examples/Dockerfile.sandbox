# examples/Dockerfile.sandbox
# Sandbox image. Package set is declarative: containers/sandbox/nixos/
# configuration.nix lists every tool; the nix-builder stage below turns it
# into a rootfs + store closure, assembled onto scratch. To add a tool:
# edit configuration.nix, rebuild. No more curl|bash chains here.

ARG OD_REF=open-design-v0.16.1

# --- Open Design build stage (must stay glibc: better-sqlite3 dlopen) ---
FROM docker.io/library/node:24-bookworm-slim AS od-build
ARG OD_REF
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN git clone --depth 1 --branch ${OD_REF} https://github.com/nexu-io/open-design.git .
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @open-design/daemon build \
    && pnpm --filter @open-design/web build \
    && pnpm --filter @open-design/daemon deploy --legacy --prod /build/deploy/daemon

# --- Nix build stage: rootfs + store closure from the flake ---
FROM docker.io/nixos/nix:latest AS nix-builder
RUN printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'sandbox = false' \
      'filter-syscalls = false' \
    >> /etc/nix/nix.conf
WORKDIR /repo
COPY . .
# --override-input: the flake's repo input is declared relative (path:../..),
# which nix resolves from the flake's copy in /nix/store — escaping to /nix.
# Overriding with the absolute context path sidesteps that.
RUN nix build --override-input repo path:/repo \
      ./containers/sandbox/nixos#rootfs -o /result \
    && mkdir -p /export/nix/store /export/rootfs \
    && nix path-info -r /result | xargs -I{} cp -a {} /export/nix/store/ \
    && cp -a /result/. /export/rootfs/ \
    && chmod -R u+w /export/rootfs

ENV PATH="/export/rootfs/home/gem/.npm-global/bin:/export/rootfs/bin:/export/rootfs/usr/bin:${PATH}"

# Pre-trust GitHub host key (network step, so it lives in Docker not nix)
RUN ssh-keyscan github.com >> /export/rootfs/etc/ssh/ssh_known_hosts

# npm global tools (npm registry, not nixpkgs). opencode-linux-x64 is the
# platform binary package installed directly: the opencode-ai launcher's
# libc detection sees the musl nixos/nix builder and picks the wrong variant,
# while nixpkgs node (and the final image) are glibc.
RUN npm install -g --prefix /export/rootfs/home/gem/.npm-global \
      opencode-linux-x64@1.18.5 @anthropic-ai/claude-code openspec-extensions opencode-with-claude \
      typescript typescript-language-server prettier openwiki \
    && ln -sf ../lib/node_modules/opencode-linux-x64/bin/opencode \
      /export/rootfs/home/gem/.npm-global/bin/opencode \
    && HOME=/export/rootfs/home/gem openspec init --tools opencode --force /export/rootfs/home/gem/

# OpenWiki + Z.ai GLM-5.x compat patches.
# 1. zai-patch.js: monkey-patches global fetch to inject thinking:{type:"disabled"}
#    on Z.ai requests (GLM emits reasoning_content by default; langchain's stream
#    aggregator chokes on it). Auto-loaded via NODE_OPTIONS in service.yml.
# 2. completions.js patch: force assistant role when delta has tool_calls/content
#    but no explicit role. GLM omits role on mid-stream chunks; without this the
#    aggregator falls back to ChatMessageChunk, which deepagents' middleware
#    rejects ("expected AIMessage or Command, got object").
COPY containers/sandbox/bin/zai-patch.js /export/rootfs/home/gem/bin/zai-patch.js
RUN chmod 644 /export/rootfs/home/gem/bin/zai-patch.js \
    && sed -i 's|const role = delta.role ?? defaultRole;|const fallbackRole = (delta.tool_calls || delta.content || delta.reasoning_content) ? "assistant" : defaultRole; const role = delta.role ?? fallbackRole;|' \
      /export/rootfs/home/gem/.npm-global/lib/node_modules/openwiki/node_modules/@langchain/openai/dist/converters/completions.js \
    && sed -i 's|const role = delta.role ?? defaultRole;|const fallbackRole = (delta.tool_calls || delta.content || delta.reasoning_content) ? "assistant" : defaultRole; const role = delta.role ?? fallbackRole;|' \
      /export/rootfs/home/gem/.npm-global/lib/node_modules/openwiki/node_modules/@langchain/openai/dist/converters/completions.cjs

# Rust toolchain (rustup manages its own store; mirrored at /usr/local/*).
# `rustup default stable` populates RUSTUP_HOME but not CARGO_HOME/bin (only
# rustup-init does) — seed the shim hardlinks manually; rustup proxies by argv[0].
ENV RUSTUP_HOME=/export/rustup CARGO_HOME=/export/cargo
RUN rustup default stable && rustup component add rust-analyzer \
    && mkdir -p /export/cargo/bin \
    && cp "$(readlink -f "$(command -v rustup)")" /export/cargo/bin/rustup \
    && for t in cargo rustc rust-analyzer rustfmt rustdoc; do \
         ln /export/cargo/bin/rustup "/export/cargo/bin/$t"; \
       done

# Python tools via uv + graphify (installed as the future gem home)
RUN export HOME=/export/rootfs/home/gem \
    && uv tool install graphifyy \
    && uv tool install basedpyright \
    && uv tool install ruff \
    && "$HOME/.local/bin/graphify" install --platform opencode

# od CLI wrapper
RUN printf '#!/bin/sh\nexec node /home/gem/open-design/apps/daemon/bin/od.mjs "$@"\n' \
      > /export/rootfs/usr/local/bin/od && chmod +x /export/rootfs/usr/local/bin/od

# setuid helper: sudo (github-push reads the root-owned PEM; entrypoint
# scripts drop to gem via sudo -Hu). Real binary must be copied out of the
# store: setuid bits don't survive nix. Note: no su — nixpkgs shadow doesn't
# ship it, and sudo covers every use.
RUN for b in sudo; do \
      src="$(readlink -f /export/rootfs/bin/$b)"; \
      rm -f "/export/rootfs/bin/$b" "/export/rootfs/usr/bin/$b"; \
      cp "$src" "/export/rootfs/usr/bin/$b"; \
      chmod 4755 "/export/rootfs/usr/bin/$b"; \
    done

RUN chown -R 1000:1000 /export/rootfs/home/gem

# --- Runtime stage: scratch + closure + artifacts ---
FROM scratch

COPY --from=nix-builder /export/nix/store /nix/store
COPY --from=nix-builder /export/rootfs /
COPY --from=nix-builder /export/rustup /usr/local/rustup
COPY --from=nix-builder /export/cargo /usr/local/cargo

# Open Design runtime artifacts (built in od-build stage)
COPY --from=od-build --chown=1000:1000 /build/deploy/daemon         /home/gem/open-design/apps/daemon
COPY --from=od-build --chown=1000:1000 /build/apps/web/out          /home/gem/open-design/apps/web/out
COPY --from=od-build --chown=1000:1000 /build/skills                /home/gem/open-design/skills
COPY --from=od-build --chown=1000:1000 /build/design-systems        /home/gem/open-design/design-systems
COPY --from=od-build --chown=1000:1000 /build/craft                 /home/gem/open-design/craft
COPY --from=od-build --chown=1000:1000 /build/prompt-templates      /home/gem/open-design/prompt-templates
COPY --from=od-build --chown=1000:1000 /build/assets/frames         /home/gem/open-design/assets/frames
COPY --from=od-build --chown=1000:1000 /build/assets/community-pets /home/gem/open-design/assets/community-pets
COPY --from=od-build --chown=1000:1000 /build/plugins/_official     /home/gem/open-design/plugins/_official

ENV PATH="/home/gem/.local/bin:/home/gem/.npm-global/bin:/usr/local/cargo/bin:/usr/local/bin:/bin:/usr/bin" \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LOCALE_ARCHIVE=/usr/lib/locale/locale-archive \
    SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt \
    NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt

WORKDIR /home/gem/projects
ENTRYPOINT ["/entrypoint.sh"]
