# /opt/codery/.env — the single secrets file for CORE + TOOLS layers.
# Stage these keys (as /root/secrets.env) before running host/bootstrap.sh.
# Project secrets do NOT go here — they live in each project's own repo.
# Permissions on the assembled file: 0600, root-owned. Values with $ must be
# single-quoted.

# --- Identity ---------------------------------------------------------
DOMAIN_NAME=example.com              # wildcard TLS + all subdomains hang off this
TZ=America/Los_Angeles

# --- Perimeter / DNS --------------------------------------------------
TAILSCALE_AUTH_KEY=tskey-auth-…      # pre-authorized, reusable, with expiry
CLOUDFLARE_API_TOKEN=…               # zone DNS edit — wildcard cert (DNS-01) + dns-update
CLOUDFLARE_ZONE_ID=…                 # Cloudflare zone id for DOMAIN_NAME

# --- GitHub (App auth for agents + CI images) --------------------------
GITHUB_APP_ID=…
GITHUB_APP_SLUG=…
GHCR_USERNAME=…                      # pulls private ghcr.io/coderyoss images
GHCR_TOKEN=…

# --- LLM providers (agent runs; all optional except the ones you use) --
ANTHROPIC_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=

# --- Operator credentials ----------------------------------------------
PASEO_PASSWORD=…                     # paseo SSH (operator key auth preferred)
OPENCODE_BASIC_AUTH=…                # "user:bcrypt" — spare; tailnet is the perimeter
OPENDESIGN_BASIC_AUTH=…              # spare — opendesign daemon auth is disabled
DOCKHAND_BASIC_AUTH=…                # spare — Dockhand has its own login

# --- Paths (bootstrap sets these; listed for completeness) -------------
SSH_DIR=/opt/codery/ssh              # authorized_keys + agent-to-apps keypair
STACKS_DIR=/opt/codery/stacks
ORIGIN=code.$DOMAIN_NAME
