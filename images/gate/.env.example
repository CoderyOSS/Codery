# GitAuthGate stack env — copy to .env beside this file and fill in.
# .env is gitignored; project secrets never leave the project repo.

# Public URL your reverse proxy exposes (empty = internal-alias fallback).
GATE_PUBLIC_URL=https://gag.example.com

# AES-256 key guarding the machine PAT at rest (required):
#   openssl rand -base64 32
GATE_TOKEN_ENC_KEY=

# GitHub machine account login that owns the custodied PAT (required).
GATE_MACHINE_LOGIN=

# Control channel (GATE-013): the ntfy broker. All four keys or none —
# a partial set refuses to boot. Unset = no control plane (holds fail closed).
# NTFY_URL must be byte-identical to the NTF-AI app's server address.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=gate-control-…
NTFY_ANSWERS_TOPIC=gate-answers-…
NTFY_TOKEN=tk_…
