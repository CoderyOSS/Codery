# GitAuthGate stack env — copy to .env beside this file and fill in.
# .env is gitignored; project secrets never leave the project repo.

# Public URL your reverse proxy exposes (empty = internal-alias fallback).
GATE_PUBLIC_URL=https://gag.example.com

# AES-256 key guarding the machine PAT at rest (required):
#   openssl rand -base64 32
GATE_TOKEN_ENC_KEY=

# GitHub machine account login that owns the custodied PAT (required).
GATE_MACHINE_LOGIN=

# Telegram control plane (optional — unset = dangerous holds fail closed).
# GATE-012: choose ONE channel — Telegram here OR the Matrix keys below,
# never both (the gate refuses to boot with both configured).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=
TELEGRAM_CHAT_ID=

# …or the Matrix control plane instead (E2EE room, see docs/guides/
# gitauthgate-setup.md). Partial sets refuse to boot; empty allowlist
# drops everything.
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=
MATRIX_USER_ALLOWLIST=
